"显示窗口缩略图" = "Show Window Thumbnails";
"需要“屏幕录制”权限，授权后请重新打开 Macindows" = "Requires Screen Recording permission. Reopen Macindows after granting it.";
"登录时自动启动" = "Launch at Login";
"辅助功能权限：已授权" = "Accessibility: Granted";
