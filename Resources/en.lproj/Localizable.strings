/* English strings, keyed by the Simplified Chinese text used in the source. */

/* Menu bar menu */
"启用 Macindows" = "Enable Macindows";
"显示程序坞窗口缩略图" = "Show Dock Window Thumbnails";
"用 ⌘Tab 切换窗口" = "Switch Windows with ⌘Tab";
"⌘Tab 未能启用，请关闭并重新打开窗口切换开关" = "⌘Tab Unavailable. Turn the Window Switcher Off and On to Retry.";
"停在缩略图上时预览整个窗口" = "Preview the Whole Window When Resting on a Thumbnail";
"需要“录屏与系统录音”权限，点此打开系统设置" = "Needs Screen & System Audio Recording Permission. Click to Open System Settings";
"授权后请重新打开 Macindows" = "Reopen Macindows after granting it.";
"登录时自动启动" = "Launch at Login";
"辅助功能权限：已授权" = "Accessibility: Granted";
